# Copy to .env. scripts/start.ps1 reads these simple KEY=value entries.
REDIS_URL=redis://127.0.0.1:6379/0
RAY_ADDRESS=http://127.0.0.1:8265
TOTAL_CPUS=2
TOTAL_MEMORY_MB=2048
DEFAULT_MEMORY_MB=1024
AGING_INTERVAL_SECONDS=60
BACKFILL_MAX_BYPASS=3
# Leave empty to generate backend/data/api-token on first API startup. Never commit a real token.
TRAINPLANE_API_TOKEN=
HEARTBEAT_TIMEOUT=15
HEARTBEAT_STARTUP_GRACE=90
SCHEDULER_INTERVAL=1
# Optional absolute path; empty means backend/data.
TRAINPLANE_DATA_DIR=

